@model IEnumerable<PugaD_TallerMVC1.Models.Equipo>

@{
    ViewData["Title"] = "List";
}

<h1>Tabla de posiciones</h1>

</p>

<style>
    .ocultar-id {
        display: none;
    }
</style>

<table class="table tabla-posiciones">
    <style>
        .ocultar-id {
            display: none;
        }

        
        table {
            color: white;
        }

        th {
            color: white; 
        }

        td {
            color: white; 
        }

        h1{
            color: white;
        }
    </style>

    <thead>
        <tr>
            <!-- Ocultamos el encabezado del Id -->
            <th class="ocultar-id">
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosJugados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosGanados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosEmpatados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartidosPerdidos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- Ocultamos la celda del Id -->
                <td class="ocultar-id">
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PartidosJugados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PartidosGanados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PartidosEmpatados)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PartidosPerdidos)
                </td>
                <td>
                    <!-- Grupo de botones con estilo Bootstrap -->
                    <div class="btn-group" role="group" aria-label="Acciones">
                        <a class="btn btn-outline-warning" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                        <a class="btn btn-outline-primary" href="@Url.Action("Details", new { id = item.Id })">Details</a>
                        <a class="btn btn-outline-danger" href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
